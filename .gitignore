.DS_Store
._*
.venv*/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.claude/settings.local.json
.vscode/
scratch/
*.tmp
*.log
mpl_voltquant/
models/

# Root Data directory (legacy raw files)
/data/
!/data/CHECKSUMS.sha256

# Trial 1 & 2 raw data directories
trial_01_nasa_pcoe/**/data/
trial_02_calce_cs2/data/*
!trial_02_calce_cs2/data/README.md

# Trial 3 raw files (>10MB)
trial_03_mit_lfp/data/*.mat
trial_03_mit_lfp/data/*raw*

# Allow Trial 3 lightweight cohort data (<100KB)
!trial_03_mit_lfp/data/mit_cycle_life_clean.csv
!trial_03_mit_lfp/data/mit_cycle_life_processed.parquet
!trial_03_mit_lfp/data/mit_splits_70_30_x20.csv
!trial_03_mit_lfp/data/FEATURES.md
!trial_03_mit_lfp/data/README.md

# Allow documentation & publication figures
!docs/*.md
!docs/*.docx
!docs/*.html
!docs/figures/*.png
!trial_02_calce_cs2/reports/figures/*.png
!trial_03_mit_lfp/reports/figures/*.png
