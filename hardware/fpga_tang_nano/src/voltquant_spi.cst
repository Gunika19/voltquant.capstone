// Tang Nano 20K -- ESP32 SPI link + LEDs
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// SPI from ESP32 (3.3 V logic). Left header, LCD-pin positions (verified on the
// schematic: these nets only reach the header and the unused LCD connector).
IO_LOC "spi_cs_n" 25;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "spi_sclk" 27;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "spi_mosi" 28;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "spi_miso" 26;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
